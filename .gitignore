# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# The automation server is a separate package with its own lockfile, so its
# node_modules must be ignored independently of the root one.
/automation-server/node_modules/

# next.js
/.next/
/.next-desktop/
/out/

# production
# The electron bundle of playwright browsers is a ~386MB build artefact, but the
# app icon is source and must be committed - electron-builder and the tray both
# read it from the repo.
/build/*
!/build/icon.ico

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# automation server runtime output
/automation-server/logs/
/automation-server/downloads/
/automation-server/tmp/

# electron
/dist-electron/
