{
  "name": "accounting-task-manager",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "automation:dev": "node automation-server/server.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "desktop:prepare": "node scripts/prepare-electron-build.mjs",
    "desktop:dev": "electron electron/main.js",
    "desktop:build": "npm run icons && npm run build:desktop && npm run desktop:prepare && electron-builder",
    "dist:win": "npm run icons && npm run build:desktop && npm run desktop:prepare && electron-builder --win nsis portable",
    "postinstall": "echo 'Skipping Playwright install in CI/CD...'",
    "check:automation-schema": "node scripts/check-automation-schema.mjs",
    "setup-local": "npx playwright install chromium"
  },
  "build": {
    "appId": "com.bcl.task-manager",
    "productName": "Task Manager",
    "asar": true,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "package.json",
      "electron/**/*",
      "!**/node_modules/**/*",
      "node_modules/@supabase/**/*",
      "node_modules/@types/**/*",
      "node_modules/iceberg-js/**/*",
      "node_modules/tr46/**/*",
      "node_modules/tslib/**/*",
      "node_modules/undici-types/**/*",
      "node_modules/webidl-conversions/**/*",
      "node_modules/whatwg-url/**/*",
      "node_modules/ws/**/*",
      "!**/*.d.ts",
      "!**/*.map",
      "!**/*.md"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "next-server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "next-server/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "automation-server",
        "to": "automation-server",
        "filter": [
          "**/*",
          "!logs/**",
          "!downloads/**",
          "!tmp/**"
        ]
      },
      {
        "from": "automation-server/node_modules",
        "to": "automation-server/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/ms-playwright-browsers",
        "to": "ms-playwright",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Task Manager"
    },
    "portable": {
      "artifactName": "TaskManager-Portable-${version}.${ext}"
    },
    "artifactName": "TaskManager-Setup-${version}.${ext}",
    "publish": null
  },
  "dependencies": {
    "@ckeditor/ckeditor5-react": "^11.0.0",
    "@cyntler/react-doc-viewer": "^1.17.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@firebase/app": "^0.14.1",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.1",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
