    "pizzip": "^3.2.0",
    "playwright": "1.57.0",
    "playwright-core": "1.57.0",
    "qs": "^6.16.0",
    "react": "18.3.1",
    "react-day-picker": "8.10.1",
    "react-doc-viewer-plus": "^1.0.4",
