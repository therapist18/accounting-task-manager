    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.6",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
