// @ts-nocheck
// overall-view/ReportTable.tsx

"use client";

import React, { useMemo } from "react"
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table"
import { Loader2 } from "lucide-react"
import { formatDateValue } from "../utils/taskManagerData"
import { getCellContent } from "../overall-view/tableUtils";

interface ReportTableProps {
  tasks: any[];
  report: any;
  loading: boolean;
  stages: any[];
  kycDocuments: Map<string, any>;
  tableHeaders: any[];
  enhancedTasksData: Map<string, any>;
  taskDependants: Map<string, any[]>;
  expandedDependants: Set<string>;
  companies: Map<number, string>;
  getTaskHierarchy: (task: any) => any;
  getStaffName: (staffId: string) => string;
  getEnhancedImmigrationStatus: (task: any) => any;
  getCurrentStageStatus: (task: any) => any;
  renderImmigrationStatusCell: (task: any) => React.ReactNode;
  renderCurrentStageStatusCell: (task: any) => React.ReactNode;
  toggleDependantsExpansion: (taskId: string) => void;
  setLinkingTask: (task: any) => void;
  setIsLinkDialogOpen: (open: boolean) => void;
  getDocumentForTaskStage: (task: any, stage: any) => any;
}

export const ReportTable = ({
  tasks = [],
  report,
  loading = false,
  stages = [],
  kycDocuments = new Map(),
  tableHeaders = [],
  enhancedTasksData = new Map(),
  taskDependants = new Map(),
  expandedDependants = new Set(),
  companies = new Map(),
  getTaskHierarchy = () => ({}),
  getStaffName = () => '',
  getEnhancedImmigrationStatus = () => ({}),
  getCurrentStageStatus = () => ({}),
  renderImmigrationStatusCell = () => null,
  renderCurrentStageStatusCell = () => null,
  toggleDependantsExpansion = () => {},
  setLinkingTask = () => {},
  setIsLinkDialogOpen = () => {},
  getDocumentForTaskStage = () => ({}),
}: ReportTableProps) => {
  const columns = useMemo(() => {
    if (!report?.configuration) return [];
    const generatedColumns = [];

    // 1. Add selected task-level fields (from standard headers)
    report.configuration.taskFields?.forEach(fieldId => {
      const header = tableHeaders.find(h => h.id === fieldId);
      if (header) {
        generatedColumns.push({
          id: `task_${fieldId}`,
          label: header.label,
          type: 'task',
          field: fieldId
        });
      }
    });

    // 2. Add columns for stages and their nested documents/fields
    if (report.configuration.stages) {
      Object.entries(report.configuration.stages).forEach(([stageId, stageConfig]: [string, any]) => {
        const stage = stages.find(s => s.id === stageId);
        if (!stage) return;

        // Add a column for the stage completion date if selected
        if (stageConfig.isStageDateSelected) {
          generatedColumns.push({
            id: `stage_date_${stageId}`,
            label: `${stage.name} Date`,
            type: 'stage_date',
            stageId: stageId
          });
        }

        // Add columns for selected document fields
        if (stageConfig.documents) {
          Object.entries(stageConfig.documents).forEach(([kycId, docConfig]: [string, any]) => {
            const kycDoc = kycDocuments.get(kycId);
            if (!kycDoc) return;
            
            docConfig.fields?.forEach((fieldId: string) => {
              const field = kycDoc.fields?.find((f: any) => f.id === fieldId);
              if (!field) return;
              generatedColumns.push({
                id: `field_${stageId}_${kycId}_${fieldId}`,
                label: `${stage.name} - ${field.fieldName}`,
                type: 'extracted_field',
                stageId,
                kycId,
                fieldId,
                fieldName: field.fieldName,
                fieldType: field.fieldType
              });
            });
          });
        }
      });
    }
    
    return generatedColumns;
  }, [report, stages, kycDocuments, tableHeaders]);

  const getCellContentForReport = (task: any, column: any) => {
    try {
      if (!task || !column) return '-';
      
      switch (column.type) {
        case 'task':
          if (!column.field) return '-';
          
          try {
            const content = getCellContent(
              task,
              column.field,
              enhancedTasksData,
              taskDependants,
              expandedDependants,
              companies,
              getTaskHierarchy,
              getStaffName,
              getEnhancedImmigrationStatus,
              getCurrentStageStatus,
              () => renderImmigrationStatusCell(task),
              () => renderCurrentStageStatusCell(task),
              toggleDependantsExpansion,
              setLinkingTask,
              setIsLinkDialogOpen
            );
            return content || '-';
          } catch (error) {
            console.error('Error in getCellContent:', error);
            return '-';
          }

        case 'stage_date': {
          const stageData = task.stages?.[column.stageId];
          return stageData?.date ? formatDateValue(stageData.date) : '-';
        }

        case 'extracted_field': {
          if (!stages || !getDocumentForTaskStage) return '-';
          const stage = stages.find(s => s.id === column.stageId);
          const stageDocInfo = stage?.documents?.find((d: any) => d.kycId === column.kycId);
          if (!stage || !stageDocInfo) return '-';

          try {
            const linkedDocument = getDocumentForTaskStage(task, { ...stage, documents: [stageDocInfo] });
            if (!linkedDocument?.extracted_details) return '-';

            const fieldValue = linkedDocument.extracted_details[column.fieldName] || 
                              linkedDocument.extracted_details[column.fieldId] || 
                              '-';
            if (column.fieldType?.toLowerCase() === 'date') return formatDateValue(fieldValue);
            return fieldValue;
          } catch (error) {
            console.error('Error getting extracted field:', error);
            return '-';
          }
        }

        default:
          return '-';
      }
    } catch (error) {
      console.error('Error in getCellContentForReport:', error);
      return '-';
    }
  };

  if (loading) return <div className="flex justify-center items-center py-10"><Loader2 className="h-8 w-8 animate-spin text-slate-500" /></div>;
  if (!tasks.length) return <div className="text-center py-10 text-slate-500">No tasks to display for this report.</div>;
  if (!report || !columns.length) return <div className="text-center py-10 text-slate-500">Report configuration is invalid or has no columns selected.</div>;

  return (
    <div className="overflow-x-auto">
      <Table>
        <TableHeader>
          <TableRow>
            {columns.map(col => (
              <TableHead key={col.id} className="whitespace-nowrap">
                {col.label}
              </TableHead>
            ))}
          </TableRow>
        </TableHeader>
        <TableBody>
          {tasks.map(task => (
            <TableRow key={task.id}>
              {columns.map(col => (
                <TableCell key={`${task.id}-${col.id}`} className="text-sm">
                  {getCellContentForReport(task, col)}
                </TableCell>
              ))}
            </TableRow>
          ))}
        </TableBody>
      </Table>
    </div>
  );
};
